# Leave empty to use the vite-served /data from data/web.
# Point at the FastAPI service when using date-stamped exports.
# VITE_DATA_BASE=http://127.0.0.1:8000

# Tianditu browser key for the globe tab (put the real key in web/.env.local, which is not committed).
VITE_TIANDITU_TK=your-tianditu-key

# Dev only: `esri` swaps the globe basemap to Esri World Imagery under `npm run dev`
# (for machines Tianditu blocks). Ignored by `vite build`.
# VITE_DEV_BASEMAP=esri
